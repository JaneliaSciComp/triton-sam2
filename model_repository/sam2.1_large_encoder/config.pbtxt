name: "sam2.1_large_encoder"
backend: "python"

# Public SAM2.1-large encoder endpoint, FP32 outputs. A client sends EITHER the
# raw `image` tensor or a `jpeg_image`; this model forwards to the real ONNX
# encoder, `sam2.1_large_encoder_onnx`, via BLS. See 1/model.py for why the
# public name is a Python model rather than the ONNX model itself.
#
# ONE endpoint serves both precisions. By default the three tensors come back
# FP32, which is what released Paintera builds expect and is bit-identical to
# what this endpoint has always returned. A client that sends the request
# parameter `request_fp16: true` gets them cast to FLOAT16 instead, halving the
# response from 16.8 MB to 8.4 MB. Old clients don't know the parameter, don't
# send it, and are unaffected.
#
# This replaces the separate `sam2.1_large_encoder_fp16` endpoint and its
# ~890 MB of duplicate weights (both removed 2026-09-17). That export was the
# same fp32 network with three Cast->FLOAT16 nodes on its outputs, so casting
# here is not an approximation of it: `fp32_output.astype(float16)` was verified
# BIT-IDENTICAL to what that model returned. Keeping the fp32 weights rather
# than the fp16 ones is deliberate -- it is the direction that loses nothing
# (the reverse, upcasting fp16->fp32 for old clients, would have handed them
# fp16-precision values in an fp32 container), and prod already has this file,
# so nothing new has to be shipped there.
#
# NOTE on the declared output dtype below. Triton does not enforce a python
# model's declared output dtype -- verified on 25.01: a declared-FP32 output
# returned as FLOAT16 reaches the client correctly as float16. That is what lets
# one output name carry either precision. So TYPE_FP32 here means "the default",
# not "a guarantee", and /v2/models/.../config will understate what the fp16
# path returns. A client that sizes buffers from the model metadata rather than
# from the response needs to know this.
#
# max_batch_size 1 + dynamic_batching: the batching scheduler is the only one
# that DROPS cancelled requests while they are still queued (the default
# scheduler dequeues and executes them, merely discarding the response), and it
# is what enables request priority. The ONNX export cannot batch -- batch=1 is
# hard-wired -- which is exactly why the batching lives here instead.
#
# Wire shapes: dims below EXCLUDE the leading batch dimension, so `image` is
# [1,3,1024,1024] on the wire (unchanged) and `jpeg_image` is [1,1].
max_batch_size: 1

input [
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [ 3, 1024, 1024 ]
    # Optional: supply this OR jpeg_image, never both, never neither.
    # Passed through to the encoder untouched -- the caller has already applied
    # SAM's normalization.
    optional: true
  },
  {
    name: "jpeg_image"
    data_type: TYPE_STRING   # Triton's config type for BYTES tensors
    dims: [ 1 ]
    # One JPEG, already scaled to 1024x1024. The server decodes it and applies
    # ((x/255) - mean) / std from the parameters below, because the SAM2 graph
    # does not normalize internally.
    optional: true
  }
]

output [
  {
    name: "high_res_feats_0"
    data_type: TYPE_FP32
    dims: [ 32, 256, 256 ]
  },
  {
    name: "high_res_feats_1"
    data_type: TYPE_FP32
    dims: [ 64, 128, 128 ]
  },
  {
    name: "image_embed"
    data_type: TYPE_FP32
    dims: [ 256, 64, 64 ]
  }
]

dynamic_batching {
  priority_levels: 2
  default_priority_level: 2
}

instance_group [
  {
    # Must be >= the inner ONNX model's instance count: each BLS .exec() blocks
    # its instance. Prod runs two sam2.1_large_encoder_onnx instances, both on
    # card 1 (a third does not fit beside sam1 on cards 0/2); dev runs one.
    count: 2
    kind: KIND_CPU
  }
]

parameters: {
  key: "inner_model"
  value: { string_value: "sam2.1_large_encoder_onnx" }
}
parameters: {
  key: "tensor_input"
  value: { string_value: "image" }
}
parameters: {
  key: "output_names"
  value: { string_value: "high_res_feats_0,high_res_feats_1,image_embed" }
}
parameters: {
  key: "expected_size"
  value: { string_value: "1024" }
}
# torchvision ImageNet constants -- exactly what upstream sam2's
# SAM2Transforms uses (it resizes to a square and normalizes, no padding).
parameters: {
  key: "norm_mean"
  value: { string_value: "0.485,0.456,0.406" }
}
parameters: {
  key: "norm_std"
  value: { string_value: "0.229,0.224,0.225" }
}
