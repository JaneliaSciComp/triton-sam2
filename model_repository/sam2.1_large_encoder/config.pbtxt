name: "sam2.1_large_encoder"
backend: "python"

# Cancel-aware wrapper that owns the public name "sam2.1_large_encoder" and
# forwards to the real ONNX model ("sam2.1_large_encoder_onnx") via BLS. It
# exists because the ONNX export has batch=1 hard-wired, so the ONNX model
# cannot run under the dynamic-batch scheduler — and only that scheduler drops
# CANCELLED queued requests before execution (the default scheduler executes
# them and merely discards the response). A python model has no baked batch
# dim, so this wrapper can batch (trivially, at size 1), which buys:
#   - queued requests cancelled by a gRPC client are dropped, never encoded
#   - request priority works (priority_levels below; 1 = jump the queue)
# Wire shapes are unchanged for clients: [1,3,1024,1024] in, [1,...] out.
max_batch_size: 1

input [
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [ 3, 1024, 1024 ]
  }
]

output [
  {
    name: "high_res_feats_0"
    data_type: TYPE_FP32
    dims: [ 32, 256, 256 ]
  },
  {
    name: "high_res_feats_1"
    data_type: TYPE_FP32
    dims: [ 64, 128, 128 ]
  },
  {
    name: "image_embed"
    data_type: TYPE_FP32
    dims: [ 256, 64, 64 ]
  }
]

dynamic_batching {
  priority_levels: 2
  default_priority_level: 2
}

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
