name: "sam3_tracker_encoder_fp16_onnx"
backend: "onnxruntime"
max_batch_size: 0

# The real SAM3 Tracker vision encoder. NOT called directly by clients: the
# Python model `sam3_tracker_encoder_fp16` owns the public name and forwards
# here via BLS. Renamed from `sam3_tracker_encoder_fp16` when that front end
# took over the name.
#
# This is the DEPLOYED SAM3 encoder, not this repo's `sam3_encoder`. The "_fp16"
# is genuine here: the initializers are FLOAT16 (458.7M of them) and the graph
# casts `pixel_values` up to fp16 on entry, while the three outputs stay FP32.
#
# The leading input dimension is left free even though the front end caps it at
# 1 -- no reason to bake the limit into both layers.
#
# The 1/model.onnx weights (918 MB, self-contained -- no external-data sidecar)
# are deployment-managed and not committed. Deployed configs additionally pin
# instance_group.gpus to environment-specific ordinals: prod card 1, dev card 0.
input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ -1, 3, 1008, 1008 ]
  }
]

output [
  {
    name: "image_embeddings.0"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  },
  {
    name: "image_embeddings.1"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  },
  {
    name: "image_embeddings.2"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

optimization {
  cuda {
    graphs: true
  }
}

version_policy: { all { }}
