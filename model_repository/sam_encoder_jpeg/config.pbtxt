name: "sam_encoder_jpeg"
backend: "python"
max_batch_size: 0

# Single entry point: a client sends ONE JPEG plus a "model_type" flag
# ("sam1" | "sam2" | "sam3"). This model decodes the JPEG, then dispatches to the
# matching deployed encoder via BLS (Business Logic Scripting) and returns that
# encoder's outputs. Routing lives in model.py's ROUTES table — nothing about the
# model choice is hardcoded on the client.
input [
  {
    name: "encoded_image"
    data_type: TYPE_STRING   # Triton's type for BYTES tensors; one JPEG
    dims: [ 1 ]
  },
  {
    name: "model_type"
    data_type: TYPE_STRING   # "sam1" | "sam2" | "sam3"
    dims: [ 1 ]
  }
]

# The three encoders return DIFFERENT tensors, so this model declares the UNION
# and populates only the subset for the chosen model per request. The caller must
# request the output names for the model it selected (see model.py ROUTES); a
# request that leaves outputs unspecified defaults to "all" and will fail, since
# only one model's tensors are produced per call.
output [
  {
    name: "image_embeddings"       # sam1
    data_type: TYPE_FP32
    dims: [ 1, 256, 64, 64 ]
  },
  {
    name: "high_res_feats_0"       # sam2 -- FP16 since the 2026-09-10 fp16 cutover
    data_type: TYPE_FP16
    dims: [ 1, 32, 256, 256 ]
  },
  {
    name: "high_res_feats_1"       # sam2 -- FP16 since the 2026-09-10 fp16 cutover
    data_type: TYPE_FP16
    dims: [ 1, 64, 128, 128 ]
  },
  {
    name: "image_embed"            # sam2 -- FP16 since the 2026-09-10 fp16 cutover
    data_type: TYPE_FP16
    dims: [ 1, 256, 64, 64 ]
  },
  {
    name: "image_embeddings.0"     # sam3
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  },
  {
    name: "image_embeddings.1"     # sam3
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  },
  {
    name: "image_embeddings.2"     # sam3
    data_type: TYPE_FP32
    dims: [ -1, -1, -1, -1 ]
  }
]

instance_group [
  {
    kind: KIND_CPU
  }
]
