name: "sam3_tracker_encoder_fp16"
backend: "python"

# Public SAM3 Tracker encoder endpoint. A client sends EITHER the raw
# `pixel_values` tensor or a `jpeg_image`; this model forwards to the real ONNX
# encoder, `sam3_tracker_encoder_fp16_onnx`, via BLS. See 1/model.py for why
# the public name is a Python model rather than the ONNX model itself.
#
# This is the DEPLOYED SAM3 encoder, and it is NOT this repo's `sam3_encoder`
# (a different, separately exported vision encoder from
# `pixi run download-sam3-onnx`).
#
# The "_fp16" in the name refers to the WEIGHTS, not the response: the inner
# export's initializers are genuinely FLOAT16 and its graph casts `pixel_values`
# UP to fp16 on entry, but the three outputs are FP32 on the wire. (The reverse
# of sam2.1_large_encoder_fp16, whose weights are fp32 and outputs fp16.)
#
# Note the input name and size differ from the SAM1/SAM2 endpoints:
# `pixel_values` at 1008x1008, not `image` at 1024x1024.
#
# Batch: the inner ONNX accepts a free leading dimension, but this front end
# caps it at 1. Confirmed 2026-09-16 that no caller ever sends more than one
# image, and max_batch_size 1 + dynamic_batching is what buys queue-drop of
# cancelled requests and request priority. A JPEG is one image by construction.
#
# Wire shapes: dims below EXCLUDE the leading batch dimension, so `pixel_values`
# is [1,3,1008,1008] on the wire and `jpeg_image` is [1,1].
max_batch_size: 1

input [
  {
    name: "pixel_values"
    data_type: TYPE_FP32
    dims: [ 3, 1008, 1008 ]
    # Optional: supply this OR jpeg_image, never both, never neither.
    # Passed through to the encoder untouched -- the caller has already
    # normalized it.
    optional: true
  },
  {
    name: "jpeg_image"
    data_type: TYPE_STRING   # Triton's config type for BYTES tensors
    dims: [ 1 ]
    # One JPEG, already scaled to 1008x1008. The server decodes it and applies
    # ((x/255) - 0.5) / 0.5 per the parameters below, because the SAM3 graph
    # does not normalize internally.
    optional: true
  }
]

output [
  {
    name: "image_embeddings.0"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1 ]
  },
  {
    name: "image_embeddings.1"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1 ]
  },
  {
    name: "image_embeddings.2"
    data_type: TYPE_FP32
    dims: [ -1, -1, -1 ]
  }
]

dynamic_batching {
  priority_levels: 2
  default_priority_level: 2
}

instance_group [
  {
    # Must be >= the inner ONNX model's instance count: each BLS .exec() blocks
    # its instance. sam3_tracker_encoder_fp16_onnx runs a single instance.
    count: 1
    kind: KIND_CPU
  }
]

parameters: {
  key: "inner_model"
  value: { string_value: "sam3_tracker_encoder_fp16_onnx" }
}
parameters: {
  key: "tensor_input"
  value: { string_value: "pixel_values" }
}
parameters: {
  key: "output_names"
  value: { string_value: "image_embeddings.0,image_embeddings.1,image_embeddings.2" }
}
parameters: {
  key: "expected_size"
  value: { string_value: "1008" }
}
# NOT ImageNet. Confirmed against the source model's preprocessor_config.json
# (onnx-community/sam3-tracker-ONNX): image_mean and image_std are both
# [0.5, 0.5, 0.5] with rescale_factor 1/255, i.e. this just maps to [-1, 1].
parameters: {
  key: "norm_mean"
  value: { string_value: "0.5,0.5,0.5" }
}
parameters: {
  key: "norm_std"
  value: { string_value: "0.5,0.5,0.5" }
}
