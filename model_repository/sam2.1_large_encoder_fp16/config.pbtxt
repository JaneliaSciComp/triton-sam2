name: "sam2.1_large_encoder_fp16"
backend: "onnxruntime"

# The real SAM2.1 large encoder (the 3-output export the mobile client's
# decoder consumes), FP16-output variant. It is NOT called directly by
# clients: the python wrapper model "sam2.1_large_encoder" owns the public
# name and forwards here via BLS, adding queued-request cancellation and
# priority support that this ONNX model cannot have itself (its export
# hard-wires batch=1, so it cannot run under the dynamic-batch scheduler).
# The 1/model.onnx weights are deployment-managed and not committed. Deployed
# configs additionally pin instance_group.gpus to environment-specific
# ordinals.
#
# Unlike sam3_tracker_encoder_fp16 (fp16 weights, FP32 output cast), this
# export genuinely emits FLOAT16 tensors on the wire -- confirmed against the
# ONNX graph's declared output elem_types. Replaces sam2.1_large_encoder_onnx
# (fp32) as of the 2026-09-10 cutover; provided by hulbertc via
# /misc/public/ForJody on the dev host.
max_batch_size: 0

input [
  {
    name: "image"
    data_type: TYPE_FP32
    dims: [ 1, 3, 1024, 1024 ]
  }
]

output [
  {
    name: "high_res_feats_0"
    data_type: TYPE_FP16
    dims: [ 1, 32, 256, 256 ]
  },
  {
    name: "high_res_feats_1"
    data_type: TYPE_FP16
    dims: [ 1, 64, 128, 128 ]
  },
  {
    name: "image_embed"
    data_type: TYPE_FP16
    dims: [ 1, 256, 64, 64 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

optimization {
  cuda {
    graphs: true
  }
  input_pinned_memory {
    enable: true
  }
  output_pinned_memory {
    enable: true
  }
}

version_policy: { all { }}
